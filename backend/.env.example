# Backend environment variables
# Copy this file to .env and fill in the values

# LLM API Keys (at least one required)
MISTRAL_API_KEY=
GROQ_API_KEY=

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Data paths
VECTOR_STORE_PATH=data/chroma_db
CLONE_TEMP_DIR=data/repos
DB_PATH=data/codeatlas.db

# Mistral retry settings
MISTRAL_RETRY_MAX_ATTEMPTS=2
MISTRAL_RETRY_INITIAL_DELAY=0.5
MISTRAL_RETRY_MAX_DELAY=4.0

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Job timeout (seconds)
JOB_HARD_TIMEOUT_SECONDS=300

# CORS origins (comma-separated, no spaces). Default ["*"] for local dev.
# In production, set to your Vercel frontend URL, e.g.: https://my-app.vercel.app
# When set to explicit origins, credentials are allowed; when "*", credentials are disabled.
CORS_ORIGINS=*

# Frontend URL for OAuth redirects and callbacks
# Required in production for GitHub App callback flow
FRONTEND_URL=